{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Construction RFI & Submittal Desk",
  "version": "1.0.0",
  "description": "Engineering & Architecture: RFI tracking, specification compliance, and jobsite OSHA safety logs.",
  "industry": "engineering-architecture",
  "tags": [
    "engineering",
    "compliance",
    "building-codes",
    "auditing"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "project-management-rfi-submittal-clerk",
      "path": "agents/project-management-rfi-submittal-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "compliance-osha-safety-clerk",
      "path": "agents/compliance-osha-safety-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "finance-job-costing-estimator",
      "path": "agents/finance-job-costing-estimator.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "project-management-rfi-submittal-clerk",
    "compliance-osha-safety-clerk",
    "finance-job-costing-estimator"
  ]
}
