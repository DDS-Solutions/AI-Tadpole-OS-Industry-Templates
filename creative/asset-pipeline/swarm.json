{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Creative Studio Project & Reporting Desk",
  "version": "1.0.0",
  "author": "PixelStream Studios",
  "description": "Creative Agency: Creative brief tracking, client monthly reporting, and quote estimation.",
  "industry": "Media & Creative",
  "tags": [
    "creative",
    "media",
    "assets",
    "localization"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "project-management-creative-brief-tracker",
      "path": "agents/project-management-creative-brief-tracker.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "support-client-reporting-recap-writer",
      "path": "agents/support-client-reporting-recap-writer.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "sales-quote-proposal-drafter",
      "path": "agents/sales-quote-proposal-drafter.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "project-management-creative-brief-tracker",
    "support-client-reporting-recap-writer",
    "sales-quote-proposal-drafter"
  ]
}
