{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Media Production & Creative Brief Desk",
  "version": "1.0.0",
  "description": "Media Production: Script brief tracking, production milestone recaps, and project estimate drafting.",
  "industry": "Media & Creative",
  "tags": [
    "creative",
    "scripts",
    "localization",
    "indexing",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "project-management-creative-brief-tracker",
      "path": "agents/project-management-creative-brief-tracker.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "support-client-reporting-recap-writer",
      "path": "agents/support-client-reporting-recap-writer.json",
      "supervisor": "project-management-creative-brief-tracker",
      "priority": "normal"
    },
    {
      "id": "sales-quote-proposal-drafter",
      "path": "agents/sales-quote-proposal-drafter.json",
      "supervisor": "project-management-creative-brief-tracker",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "project-management-creative-brief-tracker",
    "support-client-reporting-recap-writer",
    "sales-quote-proposal-drafter"
  ],
  "id": "creative-script-synthesizer",
  "maturity": "starter"
}
