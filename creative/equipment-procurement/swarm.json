{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Creative Studio Gear & Vendor Operations",
  "version": "1.0.0",
  "description": "Creative Studio: Camera equipment rental POs, software licensing, and studio AP reconciliation.",
  "industry": "Media & Creative",
  "tags": [
    "creative",
    "procurement",
    "inventory",
    "hardware-qa",
    "cameras"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": "finance-finance-bookkeeper-controller",
      "priority": "normal"
    },
    {
      "id": "project-management-creative-brief-tracker",
      "path": "agents/project-management-creative-brief-tracker.json",
      "supervisor": "finance-finance-bookkeeper-controller",
      "priority": "normal"
    },
    {
      "id": "finance-finance-bookkeeper-controller",
      "path": "agents/finance-finance-bookkeeper-controller.json",
      "supervisor": null,
      "priority": "critical"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "purchasing-vendor-purchasing-clerk",
    "project-management-creative-brief-tracker",
    "finance-finance-bookkeeper-controller"
  ],
  "id": "creative-equipment-procurement",
  "maturity": "starter"
}
