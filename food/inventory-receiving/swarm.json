{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Catering Quotes & Food Purchasing Swarm",
  "version": "1.0.0",
  "description": "Food & Beverage: Catering proposals, food distributor purchasing, and vendor AP reconciliation.",
  "industry": "Food & Beverage",
  "tags": [
    "food",
    "inventory",
    "shipping",
    "supplier-qa",
    "receiving"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "sales-catering-quote-drafter",
      "path": "agents/sales-catering-quote-drafter.json",
      "supervisor": "finance-finance-bookkeeper-controller",
      "priority": "normal"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": "finance-finance-bookkeeper-controller",
      "priority": "normal"
    },
    {
      "id": "finance-finance-bookkeeper-controller",
      "path": "agents/finance-finance-bookkeeper-controller.json",
      "supervisor": null,
      "priority": "critical"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "sales-catering-quote-drafter",
    "purchasing-vendor-purchasing-clerk",
    "finance-finance-bookkeeper-controller"
  ],
  "id": "food-inventory-receiving",
  "maturity": "starter"
}
