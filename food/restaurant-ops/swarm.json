{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Restaurant Floor & Shift Operations",
  "version": "1.0.0",
  "author": "FoodService Labs",
  "description": "Food & Beverage: Daily shift scheduling, health safety compliance, and register sales reconciliation.",
  "industry": "Food & Beverage",
  "tags": [
    "food",
    "restaurant",
    "inventory",
    "ordering"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "operations-shift-scheduling-coordinator",
      "path": "agents/operations-shift-scheduling-coordinator.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "compliance-food-safety-haccp-clerk",
      "path": "agents/compliance-food-safety-haccp-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "finance-finance-bookkeeper-controller",
      "path": "agents/finance-finance-bookkeeper-controller.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "operations-shift-scheduling-coordinator",
    "compliance-food-safety-haccp-clerk",
    "finance-finance-bookkeeper-controller"
  ]
}
