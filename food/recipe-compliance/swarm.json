{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Food Safety & Recipe Compliance Desk",
  "version": "1.0.0",
  "description": "Food & Beverage: HACCP safety logs, recipe allergen labeling, and dock receiving temperature checks.",
  "industry": "Food & Beverage",
  "tags": [
    "food",
    "compliance",
    "safety",
    "recipe-standards"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "compliance-food-safety-haccp-clerk",
      "path": "agents/compliance-food-safety-haccp-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-recipe-allergen-checker",
      "path": "agents/specialized-recipe-allergen-checker.json",
      "supervisor": "compliance-food-safety-haccp-clerk",
      "priority": "normal"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": "compliance-food-safety-haccp-clerk",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "compliance-food-safety-haccp-clerk",
    "specialized-recipe-allergen-checker",
    "purchasing-vendor-purchasing-clerk"
  ],
  "id": "food-recipe-compliance",
  "maturity": "starter"
}
