{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Ad Spend & Vendor Purchasing QA",
  "version": "1.0.0",
  "description": "Edge Operations: Media buy procurement, invoice verification, ad network compliance, and ISO quality auditing.",
  "industry": "digital-marketing",
  "tags": [
    "marketing",
    "adspend",
    "purchasing",
    "compliance",
    "vendor-qa"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-accounts-payable-agent",
      "path": "agents/specialized-accounts-payable-agent.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "marketing-marketing-cross-border-ecommerce",
      "path": "agents/marketing-marketing-cross-border-ecommerce.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "paid-media-paid-media-ppc-strategist",
      "path": "agents/paid-media-paid-media-ppc-strategist.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "global_workflows": [
    "workflows/ad_qa_sop.md"
  ]
}
