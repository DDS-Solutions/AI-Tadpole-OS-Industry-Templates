{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Agency Client Reporting & Project Desk",
  "version": "1.0.0",
  "description": "Agency Operations: Monthly client recap reports, creative brief tracking, and review management.",
  "industry": "digital-marketing",
  "tags": [
    "marketing",
    "seo",
    "content-strategy",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "support-client-reporting-recap-writer",
      "path": "agents/support-client-reporting-recap-writer.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "project-management-creative-brief-tracker",
      "path": "agents/project-management-creative-brief-tracker.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "support-review-reputation-clerk",
      "path": "agents/support-review-reputation-clerk.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "support-client-reporting-recap-writer",
    "project-management-creative-brief-tracker",
    "support-review-reputation-clerk"
  ]
}
