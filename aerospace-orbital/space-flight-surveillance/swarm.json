{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Aerospace & Orbital Flight Surveillance Swarm",
  "version": "1.0.0",
  "description": "Aerospace & Defense: OpenSky ADS-B flight corridor tracking, emergency squawk triage (7500/7600/7700), CelesTrak satellite pass prediction, and rocket launch trajectory coordination.",
  "industry": "Aerospace & Orbital Surveillance",
  "tags": [
    "aerospace",
    "opensky",
    "ads-b",
    "orbital",
    "satellites",
    "celestrak",
    "launches"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "aerospace-flight-telemetry-tracker",
      "path": "agents/aerospace-flight-telemetry-tracker.json",
      "supervisor": "aerospace-launch-window-coordinator",
      "priority": "normal"
    },
    {
      "id": "aerospace-orbital-satellite-tracker",
      "path": "agents/aerospace-orbital-satellite-tracker.json",
      "supervisor": "aerospace-launch-window-coordinator",
      "priority": "normal"
    },
    {
      "id": "aerospace-launch-window-coordinator",
      "path": "agents/aerospace-launch-window-coordinator.json",
      "supervisor": null,
      "priority": "critical"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "aerospace-flight-telemetry-tracker",
    "aerospace-orbital-satellite-tracker",
    "aerospace-launch-window-coordinator"
  ],
  "id": "aerospace-flight-orbital-surveillance",
  "maturity": "starter"
}
