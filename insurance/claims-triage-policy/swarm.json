{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Claims Intake & First Notice of Loss (FNOL)",
  "version": "1.0.0",
  "author": "AI-Tadpole-OS Core Team",
  "description": "Insurance: FNOL incident intake, policy coverage limits verification, loss adjuster triage, and claims reserve estimation.",
  "industry": "Insurance & Claims Processing",
  "tags": [
    "insurance",
    "claims",
    "fnol",
    "underwriting",
    "policy"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "insurance-fnol-claims-intake-specialist",
      "path": "agents/insurance-fnol-claims-intake-specialist.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "insurance-policy-coverage-verification-auditor",
      "path": "agents/insurance-policy-coverage-verification-auditor.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "insurance-loss-adjuster-reserve-analyst",
      "path": "agents/insurance-loss-adjuster-reserve-analyst.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "insurance-fnol-claims-intake-specialist",
    "insurance-policy-coverage-verification-auditor",
    "insurance-loss-adjuster-reserve-analyst"
  ]
}
