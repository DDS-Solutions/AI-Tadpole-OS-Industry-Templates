{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Logistics Dispatch & Route Maintenance Desk",
  "version": "1.0.0",
  "description": "Supply Chain Operations: Delivery fleet maintenance, DOT driver hours audit, and transport costing.",
  "industry": "logistics-supply-chain",
  "tags": [
    "logistics",
    "route-planning",
    "transit-data",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "operations-fleet-maintenance-scheduler",
      "path": "agents/operations-fleet-maintenance-scheduler.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "compliance-dot-hours-inspection-clerk",
      "path": "agents/compliance-dot-hours-inspection-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "finance-job-costing-estimator",
      "path": "agents/finance-job-costing-estimator.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "operations-fleet-maintenance-scheduler",
    "compliance-dot-hours-inspection-clerk",
    "finance-job-costing-estimator"
  ]
}
