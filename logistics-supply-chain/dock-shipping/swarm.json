{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Warehouse Dock Receiving & QA Swarm",
  "version": "1.0.0",
  "description": "Supply Chain Operations: Inbound dock traveler verification, vendor purchasing, and quality inspection.",
  "industry": "logistics-supply-chain",
  "tags": [
    "logistics",
    "shipping",
    "receiving",
    "iso9000",
    "warehouse"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "operations-receiving-traveler-clerk",
      "path": "agents/operations-receiving-traveler-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "testing-quality-inspector-traveler",
      "path": "agents/testing-quality-inspector-traveler.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "operations-receiving-traveler-clerk",
    "purchasing-vendor-purchasing-clerk",
    "testing-quality-inspector-traveler"
  ]
}
