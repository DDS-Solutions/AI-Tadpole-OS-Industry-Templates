{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Precision Agriculture Swarm",
  "version": "1.0.0",
  "author": "AgriTech Labs",
  "description": "Crop yield forecasting, soil health telemetry analysis, and irrigation optimization.",
  "industry": "Agriculture & AgTech",
  "tags": [
    "agriculture",
    "farming",
    "agronomy",
    "analytics"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.3,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "finance-finance-financial-analyst",
      "path": "agents/finance-finance-financial-analyst.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "sales-sales-pipeline-analyst",
      "path": "agents/sales-sales-pipeline-analyst.json",
      "supervisor": "finance-finance-financial-analyst",
      "priority": "normal"
    },
    {
      "id": "specialized-corporate-training-designer",
      "path": "agents/specialized-corporate-training-designer.json",
      "supervisor": "finance-finance-financial-analyst",
      "priority": "normal"
    }
  ],
  "global_workflows": [],
  "id": "agriculture-precision-farming",
  "maturity": "starter"
}
