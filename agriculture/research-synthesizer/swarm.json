{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Farm Operations & Harvest Logistics",
  "version": "1.0.0",
  "description": "Agriculture Operations: Harvest equipment dispatch, grain lot tracking, and weather-window scheduling.",
  "industry": "agriculture-agtech",
  "tags": [
    "agriculture",
    "soil",
    "agronomy",
    "telemetry",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "operations-harvest-field-scheduler",
      "path": "agents/operations-harvest-field-scheduler.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "compliance-grain-traceability-clerk",
      "path": "agents/compliance-grain-traceability-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "operations-equipment-maintenance-clerk",
      "path": "agents/operations-equipment-maintenance-clerk.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "operations-harvest-field-scheduler",
    "compliance-grain-traceability-clerk",
    "operations-equipment-maintenance-clerk"
  ]
}
