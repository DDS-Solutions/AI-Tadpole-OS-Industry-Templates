{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Patient Intake & Scheduling Desk",
  "version": "1.0.0",
  "author": "Medical Systems Inc.",
  "description": "Clinical Practice: Patient intake, appointment scheduling, HIPAA consent verification, and visit follow-ups.",
  "industry": "Medical Practices",
  "tags": [
    "healthcare",
    "patient-intake",
    "triage"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "operations-intake-scheduling-coordinator",
      "path": "agents/operations-intake-scheduling-coordinator.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-data-privacy-officer",
      "path": "agents/specialized-data-privacy-officer.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "support-customer-care-front-desk",
      "path": "agents/support-customer-care-front-desk.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "operations-intake-scheduling-coordinator",
    "specialized-data-privacy-officer",
    "support-customer-care-front-desk"
  ]
}
