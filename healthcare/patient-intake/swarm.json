{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "id": "healthcare-patient-intake",
  "name": "Patient Intake & Scheduling Desk",
  "version": "1.1.0",
  "author": "Medical Systems Inc.",
  "description": "Clinical Practice: Patient intake, appointment scheduling, HIPAA consent verification, and visit follow-ups.",
  "mission": "Coordinate clinic appointment triage, HIPAA minimum-necessary consent verification, and non-clinical front-desk communications with mandatory clinical/privacy escalation gates.",
  "industry": "Medical Practices",
  "maturity": "verified",
  "company_size": 25,
  "tags": [
    "healthcare",
    "patient-intake",
    "triage",
    "hipaa",
    "scheduling"
  ],
  "defaults": {
    "provider": "ollama-cloud",
    "model": "gemma4:31b-cloud",
    "temperature": 0.1,
    "model_config": {
      "provider": "ollama-cloud",
      "model_id": "gemma4:31b-cloud",
      "temperature": 0.1,
      "max_turns": 24
    },
    "model_config2": {
      "provider": "ollama-cloud",
      "model_id": "gemma4:31b-cloud",
      "temperature": 0.1,
      "max_turns": 16
    },
    "model_config3": {
      "provider": "ollama",
      "model_id": "gemma4:e4b",
      "temperature": 0.1,
      "max_turns": 24
    }
  },
  "roster": [
    {
      "id": "operations-intake-scheduling-coordinator",
      "path": "agents/operations-intake-scheduling-coordinator.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-data-privacy-officer",
      "path": "agents/specialized-data-privacy-officer.json",
      "supervisor": "operations-intake-scheduling-coordinator",
      "priority": "normal"
    },
    {
      "id": "support-customer-care-front-desk",
      "path": "agents/support-customer-care-front-desk.json",
      "supervisor": "operations-intake-scheduling-coordinator",
      "priority": "normal"
    }
  ],
  "agents": [
    "operations-intake-scheduling-coordinator",
    "specialized-data-privacy-officer",
    "support-customer-care-front-desk"
  ],
  "required_mcps": "mcps.json",
  "global_workflows": [
    "workflows/intake_scheduling.md",
    "workflows/data_privacy.md",
    "workflows/customer_care.md"
  ],
  "oversight_policies": [
    {
      "applies_to": ["phi_disclosure", "clinical_symptom_triage", "appointment_cancellation_or_reschedule"],
      "approver_role": "Practice Manager or Triage Nurse",
      "threshold": "Immediate escalation on urgent clinical symptoms, minor consent edge cases, or third-party PHI requests",
      "gate_agent": "operations-intake-scheduling-coordinator"
    }
  ],
  "disclosure": {
    "capabilities": ["read_file", "grep_search", "write_file"],
    "mcp_grants": [],
    "oversight_gates": [
      "Triage nurse or licensed clinician escalation required for any red-flag medical symptoms",
      "Privacy officer & front-desk human approval required before transmitting PHI or confirming slot changes"
    ],
    "egress_origins": []
  },
  "prompt_includes": ["sovereign-guardrails.md", "oversight-gate.md"],
  "evals_path": "evals/scenarios.json"
}
