{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Clinical Documentation & Prior-Auth Desk",
  "version": "1.0.0",
  "description": "Clinical Practice: Medical chart visit summaries, prior-authorization packet prep, and guideline indexing.",
  "industry": "medical-practices",
  "tags": [
    "healthcare",
    "protocols",
    "indexing",
    "clinical"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-clinical-documentation-specialist",
      "path": "agents/specialized-clinical-documentation-specialist.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "specialized-prior-auth-insurance-specialist",
      "path": "agents/specialized-prior-auth-insurance-specialist.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "specialized-data-privacy-officer",
      "path": "agents/specialized-data-privacy-officer.json",
      "supervisor": null,
      "priority": "critical"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "specialized-clinical-documentation-specialist",
    "specialized-prior-auth-insurance-specialist",
    "specialized-data-privacy-officer"
  ]
}
