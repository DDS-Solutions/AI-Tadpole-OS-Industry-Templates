{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Clinical Guideline Indexer",
  "version": "1.0.0",
  "description": "Knowledge Work: Processing medical research, clinical protocols indexing, and case summary generation.",
  "industry": "medical-practices",
  "tags": [
    "healthcare",
    "protocols",
    "indexing",
    "clinical"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-medical-billing-coding-specialist",
      "path": "agents/specialized-medical-billing-coding-specialist.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-healthcare-customer-service",
      "path": "agents/specialized-healthcare-customer-service.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "specialized-healthcare-marketing-compliance",
      "path": "agents/specialized-healthcare-marketing-compliance.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "global_workflows": [
    "workflows/guideline_sop.md"
  ],
  "agents": [
    "specialized-medical-billing-coding-specialist",
    "specialized-healthcare-customer-service",
    "specialized-healthcare-marketing-compliance"
  ]
}
