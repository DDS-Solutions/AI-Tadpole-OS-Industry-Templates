{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Clinical Guideline Indexer",
  "version": "1.0.0",
  "description": "Knowledge Work: Processing medical research, clinical protocols indexing, and case summary generation.",
  "industry": "medical-practices",
  "tags": [
    "healthcare",
    "protocols",
    "indexing",
    "clinical"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-data-privacy-officer",
      "path": "agents/specialized-data-privacy-officer.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "specialized-specialized-workflow-architect",
      "path": "agents/specialized-specialized-workflow-architect.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-specialized-model-qa",
      "path": "agents/specialized-specialized-model-qa.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "global_workflows": [
    "workflows/guideline_sop.md"
  ],
  "agents": [
    "specialized-data-privacy-officer",
    "specialized-specialized-workflow-architect",
    "specialized-specialized-model-qa"
  ]
}
