{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Solar Field Operations & Grid Interconnect",
  "version": "1.0.0",
  "author": "AI-Tadpole-OS Core Team",
  "description": "Renewable Energy: PV installation milestone tracking, utility interconnect permitting, net metering telemetry, and preventative inverter maintenance.",
  "industry": "Renewable Energy & Solar",
  "tags": [
    "solar",
    "renewables",
    "grid-interconnect",
    "clean-energy",
    "telemetry"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "renewable-solar-project-interconnect-planner",
      "path": "agents/renewable-solar-project-interconnect-planner.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "renewable-pv-telemetry-inverter-analyst",
      "path": "agents/renewable-pv-telemetry-inverter-analyst.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "renewable-field-installation-safety-coordinator",
      "path": "agents/renewable-field-installation-safety-coordinator.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "renewable-solar-project-interconnect-planner",
    "renewable-pv-telemetry-inverter-analyst",
    "renewable-field-installation-safety-coordinator"
  ]
}
