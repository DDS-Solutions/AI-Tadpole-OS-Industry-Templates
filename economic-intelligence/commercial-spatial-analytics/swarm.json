{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Commercial Spatial & Economic Intelligence Swarm",
  "version": "1.0.0",
  "description": "Economic Intelligence: Demographic market footprint analysis (Census ACS, CBP/ZBP), corporate supply chain disruption modeling, and facility hazard risk quantification for SMB digital twins.",
  "industry": "Economic & Commercial Spatial Intelligence",
  "tags": [
    "economic",
    "business-intelligence",
    "supply-chain",
    "census",
    "asset-risk",
    "market-footprint"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "economic-market-footprint-analyst",
      "path": "agents/economic-market-footprint-analyst.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "economic-supply-chain-disruption-evaluator",
      "path": "agents/economic-supply-chain-disruption-evaluator.json",
      "supervisor": "economic-market-footprint-analyst",
      "priority": "normal"
    },
    {
      "id": "economic-asset-risk-quantifier",
      "path": "agents/economic-asset-risk-quantifier.json",
      "supervisor": "economic-market-footprint-analyst",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "economic-market-footprint-analyst",
    "economic-supply-chain-disruption-evaluator",
    "economic-asset-risk-quantifier"
  ],
  "id": "commercial-spatial-analytics",
  "maturity": "starter"
}
