{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "MSSP Security Operations & Incident Desk",
  "version": "1.0.0",
  "description": "Cybersecurity: Threat detection, vulnerability patching, and security compliance audits.",
  "industry": "cybersecurity",
  "tags": [
    "security",
    "threat-intel",
    "cve",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "security-security-threat-detection-engineer",
      "path": "agents/security-security-threat-detection-engineer.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "security-security-appsec-engineer",
      "path": "agents/security-security-appsec-engineer.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "security-security-compliance-auditor",
      "path": "agents/security-security-compliance-auditor.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "security-security-threat-detection-engineer",
    "security-security-appsec-engineer",
    "security-security-compliance-auditor"
  ]
}
