{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "IT Asset & Access Governance Swarm",
  "version": "1.0.0",
  "description": "IT & Security Operations: Asset licensing, offboarding access revocation, and backup drills.",
  "industry": "Cybersecurity",
  "tags": [
    "security",
    "hardware",
    "procurement",
    "asset-inventory",
    "hardware-qa"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "infrastructure-asset-license-clerk",
      "path": "agents/infrastructure-asset-license-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "security-offboarding-access-guard",
      "path": "agents/security-offboarding-access-guard.json",
      "supervisor": "infrastructure-asset-license-clerk",
      "priority": "normal"
    },
    {
      "id": "infrastructure-backup-restore-clerk",
      "path": "agents/infrastructure-backup-restore-clerk.json",
      "supervisor": "infrastructure-asset-license-clerk",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "infrastructure-asset-license-clerk",
    "security-offboarding-access-guard",
    "infrastructure-backup-restore-clerk"
  ],
  "id": "security-hardware-inventory",
  "maturity": "starter"
}
