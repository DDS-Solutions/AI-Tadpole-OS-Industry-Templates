{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Grant Compliance & Donor Stewardship Swarm",
  "version": "1.0.0",
  "author": "AI-Tadpole-OS Core Team",
  "description": "Non-Profit: Grant deadline tracking, restricted fund spend auditing, donor acknowledgment letter generation, and 501(c)(3) tax receipting.",
  "industry": "Non-Profit & Foundations",
  "tags": [
    "non-profit",
    "grants",
    "donors",
    "fundraising",
    "compliance"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "nonprofit-grant-compliance-reporting-officer",
      "path": "agents/nonprofit-grant-compliance-reporting-officer.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "nonprofit-donor-stewardship-tax-receipt-clerk",
      "path": "agents/nonprofit-donor-stewardship-tax-receipt-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "nonprofit-volunteer-program-coordinator",
      "path": "agents/nonprofit-volunteer-program-coordinator.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "nonprofit-grant-compliance-reporting-officer",
    "nonprofit-donor-stewardship-tax-receipt-clerk",
    "nonprofit-volunteer-program-coordinator"
  ]
}
