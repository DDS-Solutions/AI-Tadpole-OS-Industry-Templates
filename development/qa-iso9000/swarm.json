{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Software QA & Release Gate Swarm",
  "version": "1.0.0",
  "description": "Software Studio: Automated test packaging, release gate audits, and client acceptance logs.",
  "industry": "Software Development",
  "tags": [
    "development",
    "qa",
    "iso9000",
    "release-management",
    "security"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "testing-qa-evidence-collector",
      "path": "agents/testing-qa-evidence-collector.json",
      "supervisor": "project-management-ticket-triage-pm",
      "priority": "normal"
    },
    {
      "id": "security-security-compliance-auditor",
      "path": "agents/security-security-compliance-auditor.json",
      "supervisor": "project-management-ticket-triage-pm",
      "priority": "normal"
    },
    {
      "id": "project-management-ticket-triage-pm",
      "path": "agents/project-management-ticket-triage-pm.json",
      "supervisor": null,
      "priority": "critical"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "testing-qa-evidence-collector",
    "security-security-compliance-auditor",
    "project-management-ticket-triage-pm"
  ],
  "id": "development-qa-iso9000",
  "maturity": "starter"
}
