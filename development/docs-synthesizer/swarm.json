{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Studio Delivery & Release Desk",
  "version": "1.0.0",
  "description": "Software Studio: Client ticket triage, changelog release writing, and scope change-order drafting.",
  "industry": "Software Development",
  "tags": [
    "development",
    "api",
    "documentation",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "project-management-ticket-triage-pm",
      "path": "agents/project-management-ticket-triage-pm.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "support-customer-release-writer",
      "path": "agents/support-customer-release-writer.json",
      "supervisor": "project-management-ticket-triage-pm",
      "priority": "normal"
    },
    {
      "id": "sales-quote-proposal-drafter",
      "path": "agents/sales-quote-proposal-drafter.json",
      "supervisor": "project-management-ticket-triage-pm",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "project-management-ticket-triage-pm",
    "support-customer-release-writer",
    "sales-quote-proposal-drafter"
  ],
  "id": "development-docs-synthesizer",
  "maturity": "starter"
}
