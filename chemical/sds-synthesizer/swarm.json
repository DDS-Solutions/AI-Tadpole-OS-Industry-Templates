{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Chemical SDS & Environmental Compliance Desk",
  "version": "1.0.0",
  "description": "Chemical Sector: 16-section SDS authoring, EPA/OSHA compliance, and batch record packaging.",
  "industry": "chemical-sector",
  "tags": [
    "chemical",
    "sds",
    "osha",
    "compliance",
    "safety"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-sds-authoring-assistant",
      "path": "agents/specialized-sds-authoring-assistant.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "support-support-legal-compliance-checker",
      "path": "agents/support-support-legal-compliance-checker.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "testing-quality-inspector-traveler",
      "path": "agents/testing-quality-inspector-traveler.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "specialized-sds-authoring-assistant",
    "support-support-legal-compliance-checker",
    "testing-quality-inspector-traveler"
  ]
}
