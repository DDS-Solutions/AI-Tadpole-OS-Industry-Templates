{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Chemical Safety Auditor",
  "version": "1.0.0",
  "author": "ChemiSafe Compliance",
  "description": "Automate chemical inventory, Safety Data Sheet (SDS) compliance auditing, and safety checklists.",
  "industry": "Chemical Sector",
  "tags": [
    "chemical",
    "safety",
    "compliance",
    "auditing"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "gis-gis-qa-engineer",
      "path": "agents/gis-gis-qa-engineer.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "security-security-compliance-auditor",
      "path": "agents/security-security-compliance-auditor.json",
      "supervisor": "gis-gis-qa-engineer",
      "priority": "normal"
    },
    {
      "id": "specialized-data-privacy-officer",
      "path": "agents/specialized-data-privacy-officer.json",
      "supervisor": "gis-gis-qa-engineer",
      "priority": "normal"
    }
  ],
  "global_workflows": [],
  "id": "chemical-process-safety",
  "maturity": "starter"
}
