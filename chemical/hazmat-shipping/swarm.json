{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Hazmat Shipping & Chemical AP Swarm",
  "version": "1.0.0",
  "description": "Chemical Sector: DOT 49 CFR dangerous goods manifests, hazmat shipping, and raw material AP.",
  "industry": "chemical-sector",
  "tags": [
    "chemical",
    "hazmat",
    "shipping",
    "receiving",
    "iso9000",
    "inventory"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-hazmat-shipping-clerk",
      "path": "agents/specialized-hazmat-shipping-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "finance-finance-bookkeeper-controller",
      "path": "agents/finance-finance-bookkeeper-controller.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "specialized-hazmat-shipping-clerk",
    "purchasing-vendor-purchasing-clerk",
    "finance-finance-bookkeeper-controller"
  ]
}
