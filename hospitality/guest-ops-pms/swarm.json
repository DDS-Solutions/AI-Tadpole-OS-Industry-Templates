{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Hotel Front Desk & Housekeeping Operations",
  "version": "1.0.0",
  "author": "AI-Tadpole-OS Core Team",
  "description": "Hospitality: Guest concierge requests, room turnover dispatch, PMS reservation reconciliation, and night-audit balancing.",
  "industry": "Hospitality & Lodging",
  "tags": [
    "hospitality",
    "hotel",
    "housekeeping",
    "reservations",
    "concierge"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "hospitality-guest-experience-concierge",
      "path": "agents/hospitality-guest-experience-concierge.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "hospitality-housekeeping-turnover-coordinator",
      "path": "agents/hospitality-housekeeping-turnover-coordinator.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "hospitality-night-audit-revenue-clerk",
      "path": "agents/hospitality-night-audit-revenue-clerk.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "hospitality-guest-experience-concierge",
    "hospitality-housekeeping-turnover-coordinator",
    "hospitality-night-audit-revenue-clerk"
  ]
}
