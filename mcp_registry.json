    {
      "id": "mcp-hardware-edge",
      "name": "Hardware & Edge Device Blueprint",
      "description": "Template MCP server for connecting to local serial interfaces (RS-232/USB scales) and Modbus TCP devices (thermal/pressure sensors).",
      "category": "IoT & Edge",
      "path": "mcp-blueprints/hardware-edge",
      "version": "1.0.0",
      "author": "AI-Tadpole-OS Core",
      "status": "verified",
      "maintainer": "AI-Tadpole-OS Security Team",
      "last_reviewed": "2026-09-01",
      "required_env": {
        "SCALE_COM_PORT": {
          "description": "Serial communications port",
          "placeholder": "COM3"
        },
        "SCALE_BAUDRATE": {
          "description": "Serial port baud rate",
          "placeholder": "9600"
        },
        "MODBUS_SENSOR_IP": {
          "description": "IP address of Modbus sensor",
          "placeholder": "192.168.1.100"
        },
        "MODBUS_PORT": {
          "description": "Modbus TCP communication port",
          "placeholder": "502"
        }
      },
