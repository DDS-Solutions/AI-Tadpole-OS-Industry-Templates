      "tools": [
        {
          "id": "hardware-edge-sensors:read_scale_weight",
          "name": "read_scale_weight",
          "description": "Connect to a serial weighing scale and read the current weight",
          "risk": "read",
          "recommendedGoalIds": ["inventory", "order-fulfillment"]
        },
        {
          "id": "hardware-edge-sensors:read_temperature_sensor",
          "name": "read_temperature_sensor",
          "description": "Read current temperature from a Modbus TCP industrial thermal sensor",
          "risk": "read",
          "recommendedGoalIds": ["compliance-review", "inventory"]
        },
        {
          "id": "hardware-edge-sensors:read_pressure_sensor",
          "name": "read_pressure_sensor",
