      "config": {
        "mcpServers": {
          "hardware-edge-sensors": {
            "command": "python",
            "args": ["server.py"],
            "env": {
              "SCALE_COM_PORT": "COM3",
              "SCALE_BAUDRATE": "9600",
              "MODBUS_SENSOR_IP": "192.168.1.100",
              "MODBUS_PORT": "502"
