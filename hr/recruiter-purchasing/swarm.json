{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "HR Vendor & Talent Operations",
  "version": "1.0.0",
  "description": "People Operations: Recruiting agency contracts, HR software seat management, and background check audits.",
  "industry": "Human Resources",
  "tags": [
    "hr",
    "procurement",
    "contractor-qa",
    "recruiting-tools"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "specialized-recruitment-specialist",
      "path": "agents/specialized-recruitment-specialist.json",
      "supervisor": "finance-finance-bookkeeper-controller",
      "priority": "normal"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": "finance-finance-bookkeeper-controller",
      "priority": "normal"
    },
    {
      "id": "finance-finance-bookkeeper-controller",
      "path": "agents/finance-finance-bookkeeper-controller.json",
      "supervisor": null,
      "priority": "critical"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "specialized-recruitment-specialist",
    "purchasing-vendor-purchasing-clerk",
    "finance-finance-bookkeeper-controller"
  ],
  "id": "hr-recruiter-purchasing",
  "maturity": "starter"
}
