{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Recruiting & Talent Acquisition Swarm",
  "version": "1.0.0",
  "author": "HR Systems Group",
  "description": "People Operations: Candidate sourcing, job descriptions, interview coordination, and scorecard aggregation.",
  "industry": "Human Resources",
  "tags": [
    "hr",
    "recruiting",
    "onboarding"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-recruitment-specialist",
      "path": "agents/specialized-recruitment-specialist.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "specialized-job-description-scorecard-writer",
      "path": "agents/specialized-job-description-scorecard-writer.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "project-management-interview-coordinator",
      "path": "agents/project-management-interview-coordinator.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "specialized-recruitment-specialist",
    "specialized-job-description-scorecard-writer",
    "project-management-interview-coordinator"
  ]
}
