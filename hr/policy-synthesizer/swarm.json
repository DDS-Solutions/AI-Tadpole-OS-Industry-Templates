{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "HR Policy & Offboarding Security Swarm",
  "version": "1.0.0",
  "description": "People Operations: Employee handbook policies, onboarding paperwork, and access deprovisioning.",
  "industry": "human-resources",
  "tags": [
    "hr",
    "policy",
    "compliance",
    "employee-handbook"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "support-handbook-policy-drafter",
      "path": "agents/support-handbook-policy-drafter.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "specialized-hr-onboarding",
      "path": "agents/specialized-hr-onboarding.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "security-offboarding-access-guard",
      "path": "agents/security-offboarding-access-guard.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "support-handbook-policy-drafter",
    "specialized-hr-onboarding",
    "security-offboarding-access-guard"
  ]
}
