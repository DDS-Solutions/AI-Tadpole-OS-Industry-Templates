{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tadpoleos.dev/schemas/template-registry-v1.json",
  "title": "AI-Tadpole-OS Template Registry Schema",
  "type": "object",
  "required": ["industries", "templates"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "company_sizes": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "industry", "path", "required_models", "content_sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "internal": {
            "type": "boolean"
          },
          "maturity": {
            "type": "string",
            "enum": ["starter", "verified"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "industry": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "company_size": {
            "type": "integer",
            "minimum": 1
          },
          "required_skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
