    {
      "label": "system override phrase",
      "pattern": "ignore\\s+(?:all\\s+)?previous\\s+instructions",
      "ignore_case": true
    },
    {
      "label": "system override phrase",
      "pattern": "disregard\\s+(?:all\\s+)?(?:previous\\s+instructions|system\\s+prompt)",
      "ignore_case": true
    },
    {
      "label": "system override phrase",
      "pattern": "you\\s+are\\s+now\\s+in\\s+developer\\s+mode",
      "ignore_case": true
    },
    {
      "label": "system override phrase",
      "pattern": "bypass\\s+(?:safety\\s+filters|oversight)",
      "ignore_case": true
    },
    {
      "label": "system override phrase",
      "pattern": "disable\\s+oversight",
      "ignore_case": true
    },
    {
      "label": "system override phrase",
      "pattern": "system\\s+prompt\\s+override",
      "ignore_case": true
    }
  ],
