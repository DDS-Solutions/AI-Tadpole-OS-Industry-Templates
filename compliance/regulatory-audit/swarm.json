{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Corporate Compliance & Audit Evidence Desk",
  "version": "1.0.0",
  "author": "TrustGuard SecOps",
  "description": "Compliance Operations: Regulatory policy tracking, audit evidence collection, and vendor security packaging.",
  "industry": "Governance & Compliance",
  "tags": [
    "compliance",
    "audit",
    "security",
    "governance"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "support-support-legal-compliance-checker",
      "path": "agents/support-support-legal-compliance-checker.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "testing-qa-evidence-collector",
      "path": "agents/testing-qa-evidence-collector.json",
      "supervisor": "support-support-legal-compliance-checker",
      "priority": "normal"
    },
    {
      "id": "compliance-vendor-risk-questionnaire-packager",
      "path": "agents/compliance-vendor-risk-questionnaire-packager.json",
      "supervisor": "support-support-legal-compliance-checker",
      "priority": "normal"
    }
  ],
  "agents": [
    "support-support-legal-compliance-checker",
    "testing-qa-evidence-collector",
    "compliance-vendor-risk-questionnaire-packager"
  ],
  "id": "compliance-regulatory-audit",
  "maturity": "starter"
}
