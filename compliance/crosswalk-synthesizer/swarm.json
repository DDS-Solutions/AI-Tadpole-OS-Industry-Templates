{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Enterprise Security & Control Crosswalk",
  "version": "1.0.0",
  "description": "Compliance Operations: Security control audits, access verification, and QA evidence aggregation.",
  "industry": "governance-compliance",
  "tags": [
    "compliance",
    "soc2",
    "iso27001",
    "crosswalk",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "support-support-legal-compliance-checker",
      "path": "agents/support-support-legal-compliance-checker.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "security-security-compliance-auditor",
      "path": "agents/security-security-compliance-auditor.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "testing-qa-evidence-collector",
      "path": "agents/testing-qa-evidence-collector.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "support-support-legal-compliance-checker",
    "security-security-compliance-auditor",
    "testing-qa-evidence-collector"
  ]
}
