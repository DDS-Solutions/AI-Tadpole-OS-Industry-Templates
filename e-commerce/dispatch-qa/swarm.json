{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "E-Commerce Fulfillment & Collections Swarm",
  "version": "1.0.0",
  "description": "E-Commerce: Warehouse packing verification, return order logistics, and wholesale AR aging.",
  "industry": "E-commerce",
  "tags": [
    "e-commerce",
    "shipping",
    "receiving",
    "inventory",
    "qa"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "support-returns-wismo-clerk",
      "path": "agents/support-returns-wismo-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "product-catalog-listing-qa",
      "path": "agents/product-catalog-listing-qa.json",
      "supervisor": "support-returns-wismo-clerk",
      "priority": "normal"
    },
    {
      "id": "finance-ar-collections-specialist",
      "path": "agents/finance-ar-collections-specialist.json",
      "supervisor": "support-returns-wismo-clerk",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "support-returns-wismo-clerk",
    "product-catalog-listing-qa",
    "finance-ar-collections-specialist"
  ],
  "id": "ecommerce-dispatch-qa",
  "maturity": "starter"
}
