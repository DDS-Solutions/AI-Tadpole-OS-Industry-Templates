{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Auto Dealership Service Bay & Parts Desk",
  "version": "1.0.0",
  "author": "AI-Tadpole-OS Core Team",
  "description": "Automotive: Repair order (RO) dispatch, OEM warranty claim submissions, parts inventory reorders, and customer service updates.",
  "industry": "Automotive Dealerships & Repair",
  "tags": [
    "automotive",
    "dealership",
    "repair",
    "service-bay",
    "parts"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "automotive-service-advisor-ro-dispatcher",
      "path": "agents/automotive-service-advisor-ro-dispatcher.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "automotive-oem-warranty-claims-clerk",
      "path": "agents/automotive-oem-warranty-claims-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "automotive-parts-inventory-counter-specialist",
      "path": "agents/automotive-parts-inventory-counter-specialist.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "automotive-service-advisor-ro-dispatcher",
    "automotive-oem-warranty-claims-clerk",
    "automotive-parts-inventory-counter-specialist"
  ]
}
