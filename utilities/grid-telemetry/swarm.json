{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Utility Grid Operations & Safety Desk",
  "version": "1.0.0",
  "author": "GridSafe Networks",
  "description": "Utilities Operations: Preventative maintenance logs, OSHA safety compliance, and parts purchasing.",
  "industry": "Critical Infrastructure",
  "tags": [
    "utilities",
    "grid",
    "telemetry",
    "scada"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "operations-equipment-maintenance-clerk",
      "path": "agents/operations-equipment-maintenance-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "compliance-osha-safety-clerk",
      "path": "agents/compliance-osha-safety-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "operations-equipment-maintenance-clerk",
    "compliance-osha-safety-clerk",
    "purchasing-vendor-purchasing-clerk"
  ]
}
