    },
    {
      "id": "operations-equipment-maintenance-clerk",
      "path": "agents/operations-equipment-maintenance-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "infrastructure-backup-restore-clerk",
      "path": "agents/infrastructure-backup-restore-clerk.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
