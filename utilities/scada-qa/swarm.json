{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Utility SCADA & Cybersecurity Governance",
  "version": "1.0.0",
  "description": "Utilities Operations: SCADA access compliance, backup restore drills, and equipment PM.",
  "industry": "critical-infrastructure",
  "tags": [
    "utilities",
    "scada",
    "shipping",
    "receiving",
    "hardware-qa",
    "procurement"
