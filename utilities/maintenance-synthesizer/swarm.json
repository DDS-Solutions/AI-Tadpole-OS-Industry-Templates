{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Utility Work Order & Infrastructure Costing",
  "version": "1.0.0",
  "description": "Utilities Operations: Equipment preventative maintenance, job costing, and safety audits.",
  "industry": "critical-infrastructure",
  "tags": [
    "utilities",
    "grid-maintenance",
    "telemetry",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "operations-equipment-maintenance-clerk",
      "path": "agents/operations-equipment-maintenance-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "compliance-osha-safety-clerk",
      "path": "agents/compliance-osha-safety-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "finance-job-costing-estimator",
      "path": "agents/finance-job-costing-estimator.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "operations-equipment-maintenance-clerk",
    "compliance-osha-safety-clerk",
    "finance-job-costing-estimator"
  ]
}
