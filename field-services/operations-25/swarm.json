{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "id": "field-service-operations-25",
  "name": "Small Field Service Operations (25 Seats)",
  "version": "1.0.0",
  "description": "Dispatch, estimate and work-order preparation, customer follow-up, and daily exception review for small appointment-based field-service teams.",
  "industry": "Field Services",
  "maturity": "verified",
  "company_size": 25,
  "tags": [
    "field-service",
    "dispatch",
    "estimates",
    "work-orders",
    "customer-care",
    "small-business"
  ],
  "defaults": {
    "provider": "ollama-cloud",
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "model_config": {
      "provider": "ollama-cloud",
      "model_id": "gemma4:31b-cloud",
      "temperature": 0.2,
      "max_turns": 24
    },
    "model_config2": {
      "provider": "ollama-cloud",
      "model_id": "gemma4:31b-cloud",
      "temperature": 0.2,
      "max_turns": 16
    },
    "model_config3": {
      "provider": "ollama",
      "model_id": "gemma4:e4b",
      "temperature": 0.2,
      "max_turns": 24
    }
  },
  "roster": [
    {
      "id": "field-service-dispatch-coordinator",
      "path": "agents/field-service-dispatch-coordinator.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "field-service-estimate-work-order-coordinator",
      "path": "agents/field-service-estimate-work-order-coordinator.json",
      "supervisor": "field-service-dispatch-coordinator",
      "priority": "normal"
    },
    {
      "id": "field-service-customer-care-coordinator",
      "path": "agents/field-service-customer-care-coordinator.json",
      "supervisor": "field-service-dispatch-coordinator",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "global_workflows": [
    "workflows/field_service_daily_operations.md"
  ],
  "oversight_policies": [
    {
      "applies_to": ["dispatch_schedule_change", "estimate_release", "outbound_customer_message"],
      "approver_role": "Dispatcher & Operations Manager",
      "threshold": "Every schedule commitment, work order estimate, safety/hazard escalation, and outbound message",
      "gate_agent": "field-service-dispatch-coordinator"
    }
  ],
  "disclosure": {
    "capabilities": ["grep_search", "read_file", "write_file"],
    "mcp_grants": [],
    "oversight_gates": [
      "Dispatcher approval required for every technician assignment or schedule update",
      "Qualified estimator & manager approval required for estimates, change orders, and outbound customer updates"
    ],
    "egress_origins": []
  },
  "evals_path": "evals/scenarios.json"
}
