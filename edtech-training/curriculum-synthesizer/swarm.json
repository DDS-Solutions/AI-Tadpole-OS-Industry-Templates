{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "EdTech Curriculum & Student Desk",
  "version": "1.0.0",
  "description": "EdTech Operations: Student enrollment, curriculum course mapping, and parent communications.",
  "industry": "EdTech & Training",
  "tags": [
    "education",
    "curriculum",
    "syllabus",
    "indexing"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "operations-enrollment-registrar-clerk",
      "path": "agents/operations-enrollment-registrar-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-corporate-training-designer",
      "path": "agents/specialized-corporate-training-designer.json",
      "supervisor": "operations-enrollment-registrar-clerk",
      "priority": "normal"
    },
    {
      "id": "support-parent-communications-drafter",
      "path": "agents/support-parent-communications-drafter.json",
      "supervisor": "operations-enrollment-registrar-clerk",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "operations-enrollment-registrar-clerk",
    "specialized-corporate-training-designer",
    "support-parent-communications-drafter"
  ],
  "id": "edtech-curriculum-synthesizer",
  "maturity": "starter"
}
