{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "EdTech Software Licensing & Vendor Operations",
  "version": "1.0.0",
  "description": "EdTech Operations: Educational software seats, vendor purchasing, and curriculum compliance.",
  "industry": "edtech-training",
  "tags": [
    "education",
    "procurement",
    "inventory",
    "saas-licensing",
    "software-asset"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "support-support-legal-compliance-checker",
      "path": "agents/support-support-legal-compliance-checker.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "finance-finance-bookkeeper-controller",
      "path": "agents/finance-finance-bookkeeper-controller.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "purchasing-vendor-purchasing-clerk",
    "support-support-legal-compliance-checker",
    "finance-finance-bookkeeper-controller"
  ]
}
