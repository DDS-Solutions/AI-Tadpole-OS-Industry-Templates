{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Fleet Dispatch & DOT Maintenance Swarm",
  "version": "1.0.0",
  "author": "TransitSphere Solutions",
  "description": "Transportation: Fleet preventative maintenance, ELD hours compliance, and vendor parts purchasing.",
  "industry": "Transportation & Logistics",
  "tags": [
    "transportation",
    "fleet",
    "logistics",
    "routes"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "operations-fleet-maintenance-scheduler",
      "path": "agents/operations-fleet-maintenance-scheduler.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "compliance-dot-hours-inspection-clerk",
      "path": "agents/compliance-dot-hours-inspection-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "agents": [
    "operations-fleet-maintenance-scheduler",
    "compliance-dot-hours-inspection-clerk",
    "purchasing-vendor-purchasing-clerk"
  ]
}
