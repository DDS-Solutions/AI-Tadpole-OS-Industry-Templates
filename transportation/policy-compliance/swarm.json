{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Transportation Regulatory & Safety Desk",
  "version": "1.0.0",
  "description": "Transportation: FMCSA hours-of-service compliance, driver qualification files, and safety audits.",
  "industry": "Transportation & Logistics",
  "tags": [
    "transportation",
    "dot",
    "compliance",
    "auditing"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "compliance-dot-hours-inspection-clerk",
      "path": "agents/compliance-dot-hours-inspection-clerk.json",
      "supervisor": "operations-fleet-maintenance-scheduler",
      "priority": "normal"
    },
    {
      "id": "support-support-legal-compliance-checker",
      "path": "agents/support-support-legal-compliance-checker.json",
      "supervisor": "operations-fleet-maintenance-scheduler",
      "priority": "normal"
    },
    {
      "id": "operations-fleet-maintenance-scheduler",
      "path": "agents/operations-fleet-maintenance-scheduler.json",
      "supervisor": null,
      "priority": "critical"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "compliance-dot-hours-inspection-clerk",
    "support-support-legal-compliance-checker",
    "operations-fleet-maintenance-scheduler"
  ],
  "id": "transportation-policy-compliance",
  "maturity": "starter"
}
