{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Legal Matter Intake & Contract Review",
  "version": "1.0.0",
  "author": "SMB Legal Inc.",
  "description": "Legal Operations: Client conflict check, first-pass contract review, and docket deadline management.",
  "industry": "legal",
  "tags": [
    "law",
    "contracts",
    "auditing"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-legal-client-intake",
      "path": "agents/specialized-legal-client-intake.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-legal-document-review",
      "path": "agents/specialized-legal-document-review.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "support-support-legal-compliance-checker",
      "path": "agents/support-support-legal-compliance-checker.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "specialized-legal-client-intake",
    "specialized-legal-document-review",
    "support-support-legal-compliance-checker"
  ]
}
