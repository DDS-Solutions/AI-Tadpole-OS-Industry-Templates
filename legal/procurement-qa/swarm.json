{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Law Firm Time & Billing Operations",
  "version": "1.0.0",
  "description": "Legal Operations: Attorney time entry audit, realization tracking, and retainer invoicing.",
  "industry": "legal-services",
  "tags": [
    "law",
    "purchasing",
    "qa",
    "vendor-compliance"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "finance-time-billing-coder",
      "path": "agents/finance-time-billing-coder.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "finance-ar-collections-specialist",
      "path": "agents/finance-ar-collections-specialist.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "specialized-legal-client-intake",
      "path": "agents/specialized-legal-client-intake.json",
      "supervisor": null,
      "priority": "critical"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "finance-time-billing-coder",
    "finance-ar-collections-specialist",
    "specialized-legal-client-intake"
  ]
}
