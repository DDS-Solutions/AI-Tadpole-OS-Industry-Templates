{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Litigation Prep & E-Discovery Desk",
  "version": "1.0.0",
  "description": "Legal Operations: E-discovery indexing, court docket calculation, and factual case timeline prep.",
  "industry": "Legal Services",
  "tags": [
    "law",
    "precedents",
    "synthesis",
    "knowledge"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "specialized-ediscovery-organizer",
      "path": "agents/specialized-ediscovery-organizer.json",
      "supervisor": "project-management-matter-docket-clerk",
      "priority": "normal"
    },
    {
      "id": "project-management-matter-docket-clerk",
      "path": "agents/project-management-matter-docket-clerk.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-legal-document-review",
      "path": "agents/specialized-legal-document-review.json",
      "supervisor": "project-management-matter-docket-clerk",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "specialized-ediscovery-organizer",
    "project-management-matter-docket-clerk",
    "specialized-legal-document-review"
  ],
  "id": "legal-precedent-synthesis",
  "maturity": "starter"
}
