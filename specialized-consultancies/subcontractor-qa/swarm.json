{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Consulting Subcontractor & Expense Swarm",
  "version": "1.0.0",
  "description": "Consulting Operations: 1099 SME contractor recruiting, vendor purchasing, and time billing.",
  "industry": "specialized-consultancies",
  "tags": [
    "consultancy",
    "procurement",
    "timesheet-qa",
    "iso9000"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "specialized-recruitment-specialist",
