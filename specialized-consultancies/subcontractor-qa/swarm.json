      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "finance-time-billing-coder",
      "path": "agents/finance-time-billing-coder.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "specialized-recruitment-specialist",
    "purchasing-vendor-purchasing-clerk",
    "finance-time-billing-coder"
  ]
