{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Consulting Time, Billing & Scope Desk",
  "version": "1.0.0",
  "description": "Consulting Operations: Time entry auditing, SOW proposal drafting, and client document collection.",
  "industry": "specialized-consultancies",
  "tags": [
    "consultancy",
    "knowledge-management",
    "synthesis",
    "interviews"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "finance-time-billing-coder",
      "path": "agents/finance-time-billing-coder.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "sales-quote-proposal-drafter",
      "path": "agents/sales-quote-proposal-drafter.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "support-client-document-coordinator",
      "path": "agents/support-client-document-coordinator.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "finance-time-billing-coder",
    "sales-quote-proposal-drafter",
    "support-client-document-coordinator"
  ]
}
