{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Tax Compliance & Client Onboarding",
  "version": "1.0.0",
  "description": "Financial Operations: Tax packet collection, KYC onboarding checklists, and quarterly tax estimate prep.",
  "industry": "Financial Services",
  "tags": [
    "finance",
    "tax",
    "policy",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "support-client-document-coordinator",
      "path": "agents/support-client-document-coordinator.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-kyc-onboarding-specialist",
      "path": "agents/specialized-kyc-onboarding-specialist.json",
      "supervisor": "support-client-document-coordinator",
      "priority": "normal"
    },
    {
      "id": "finance-finance-fpa-analyst",
      "path": "agents/finance-finance-fpa-analyst.json",
      "supervisor": "support-client-document-coordinator",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "support-client-document-coordinator",
    "specialized-kyc-onboarding-specialist",
    "finance-finance-fpa-analyst"
  ],
  "id": "financial-policy-synthesizer",
  "maturity": "starter"
}
