{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Vendor AP & Cash Disbursement Swarm",
  "version": "1.0.0",
  "description": "Financial Operations: Accounts payable 3-way matching, invoice disbursement approval, and vendor inquiries.",
  "industry": "Financial Services",
  "tags": [
    "finance",
    "invoices",
    "reconciliation",
    "purchasing",
    "audit"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "finance-finance-bookkeeper-controller",
      "path": "agents/finance-finance-bookkeeper-controller.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "finance-ar-collections-specialist",
      "path": "agents/finance-ar-collections-specialist.json",
      "supervisor": "finance-finance-bookkeeper-controller",
      "priority": "normal"
    },
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": "finance-finance-bookkeeper-controller",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "finance-finance-bookkeeper-controller",
    "finance-ar-collections-specialist",
    "purchasing-vendor-purchasing-clerk"
  ],
  "id": "financial-vendor-reconciliation",
  "maturity": "starter"
}
