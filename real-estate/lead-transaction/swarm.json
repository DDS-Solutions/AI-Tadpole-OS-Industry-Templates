      "priority": "normal"
    },
    {
      "id": "sales-showing-lead-response-clerk",
      "path": "agents/sales-showing-lead-response-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "marketing-marketing-aeo-foundations",
      "path": "agents/marketing-marketing-aeo-foundations.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  }
}
