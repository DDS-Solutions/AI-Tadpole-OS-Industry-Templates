{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "id": "lead-transaction-management",
  "name": "Real Estate Transaction & Showing Desk",
  "industry": "Real Estate",
  "company_size": 25,
  "description": "Brokerage Operations: Transaction coordination, speed-to-lead showing response, and listing packets.",
  "author": "AI-Tadpole-OS",
  "tags": [
    "real-estate",
    "leads",
    "transactions",
    "automation"
  ],
  "path": "real-estate/lead-transaction",
  "agents": [
    "project-management-transaction-coordinator",
    "sales-showing-lead-response-clerk",
    "marketing-marketing-aeo-foundations"
