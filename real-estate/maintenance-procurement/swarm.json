{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Property Management & Maintenance Swarm",
  "version": "1.0.0",
  "description": "Property Management: Tenant work-order dispatch, lease abstracting, and rent collection.",
  "industry": "Real Estate",
  "tags": [
    "real-estate",
    "procurement",
    "inventory",
    "contractor-qa",
    "maintenance"
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "roster": [
    {
      "id": "operations-tenant-work-order-dispatcher",
      "path": "agents/operations-tenant-work-order-dispatcher.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "specialized-lease-abstract-clerk",
      "path": "agents/specialized-lease-abstract-clerk.json",
      "supervisor": "operations-tenant-work-order-dispatcher",
      "priority": "normal"
    },
    {
      "id": "finance-ar-collections-specialist",
      "path": "agents/finance-ar-collections-specialist.json",
      "supervisor": "operations-tenant-work-order-dispatcher",
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "operations-tenant-work-order-dispatcher",
    "specialized-lease-abstract-clerk",
    "finance-ar-collections-specialist"
  ],
  "id": "realestate-maintenance-procurement",
  "maturity": "starter"
}
