{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Real Estate Transaction & Showing Desk",
  "version": "1.0.0",
  "description": "Brokerage Operations: Transaction coordination, speed-to-lead showing response, and listing packets.",
  "industry": "real-estate",
  "tags": [
    "real-estate",
    "valuation",
    "appraisal",
    "synthesis"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "project-management-transaction-coordinator",
      "path": "agents/project-management-transaction-coordinator.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "sales-showing-lead-response-clerk",
      "path": "agents/sales-showing-lead-response-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "specialized-lease-abstract-clerk",
      "path": "agents/specialized-lease-abstract-clerk.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "project-management-transaction-coordinator",
    "sales-showing-lead-response-clerk",
    "specialized-lease-abstract-clerk"
  ]
}
