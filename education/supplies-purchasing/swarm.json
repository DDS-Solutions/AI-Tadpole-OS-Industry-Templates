{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "School Supplies & Facilities Purchasing",
  "version": "1.0.0",
  "description": "Education Operations: School supply purchasing, facility maintenance work orders, and accounting AP.",
  "industry": "education",
  "tags": [
    "education",
    "procurement",
    "inventory",
    "textbooks",
    "supplies"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "purchasing-vendor-purchasing-clerk",
      "path": "agents/purchasing-vendor-purchasing-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "operations-equipment-maintenance-clerk",
      "path": "agents/operations-equipment-maintenance-clerk.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "finance-finance-bookkeeper-controller",
      "path": "agents/finance-finance-bookkeeper-controller.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "purchasing-vendor-purchasing-clerk",
    "operations-equipment-maintenance-clerk",
    "finance-finance-bookkeeper-controller"
  ]
}
