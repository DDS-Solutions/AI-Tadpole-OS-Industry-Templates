{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "name": "Maritime Domain Awareness & Subsea Security Swarm",
  "version": "1.0.0",
  "description": "Maritime Operations: AIS live vessel traffic tracking, dark ship gap detection, subsea telecommunications cable defense, and harbor navigation risk triage.",
  "industry": "maritime-operations",
  "tags": [
    "maritime",
    "ais",
    "vessel-tracking",
    "submarine-cables",
    "harbor-safety"
  ],
  "defaults": {
    "model": "gemma4:31b",
    "temperature": 0.2
  },
  "roster": [
    {
      "id": "maritime-vessel-traffic-analyst",
      "path": "agents/maritime-vessel-traffic-analyst.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "maritime-subsea-cable-custodian",
      "path": "agents/maritime-subsea-cable-custodian.json",
      "supervisor": null,
      "priority": "normal"
    },
    {
      "id": "maritime-coastal-safety-officer",
      "path": "agents/maritime-coastal-safety-officer.json",
      "supervisor": null,
      "priority": "normal"
    }
  ],
  "required_mcps": "mcps.json",
  "agents": [
    "maritime-vessel-traffic-analyst",
    "maritime-subsea-cable-custodian",
    "maritime-coastal-safety-officer"
  ]
}
