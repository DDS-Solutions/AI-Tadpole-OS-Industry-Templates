    {
      "id": "mcp-hardware-edge",
      "name": "Hardware & Edge Device Blueprint",
      "description": "Template MCP server for connecting to local serial interfaces (RS-232/USB scales) and Modbus TCP devices (thermal/pressure sensors).",
      "category": "IoT & Edge",
      "path": "mcp-blueprints/hardware-edge",
      "version": "1.0.0",
      "author": "AI-Tadpole-OS Core",
      "status": "verified",
      "maintainer": "AI-Tadpole-OS Security Team",
      "last_reviewed": "2026-11-13",
      "required_env": {
        "SCALE_COM_PORT": {
          "description": "Serial communications port",
          "placeholder": "COM3"
        },
        "SCALE_BAUDRATE": {
          "description": "Serial port baud rate",
          "placeholder": "9600"
        },
        "MODBUS_SENSOR_IP": {
          "description": "IP address of Modbus sensor",
          "placeholder": "192.168.1.100"
        },
        "MODBUS_PORT": {
          "description": "Modbus TCP communication port",
          "placeholder": "502"
        }
      },
      "variables": [
        {
          "name": "SCALE_COM_PORT",
          "type": "text",
          "required": true,
          "default": "COM3",
          "description": "Serial communications port"
        },
        {
          "name": "SCALE_BAUDRATE",
          "type": "text",
          "required": true,
          "default": "9600",
          "description": "Serial port baud rate"
        },
        {
          "name": "MODBUS_SENSOR_IP",
          "type": "text",
          "required": true,
          "default": "192.168.1.100",
          "description": "IP address of Modbus sensor"
        },
        {
          "name": "MODBUS_PORT",
          "type": "text",
          "required": true,
          "default": "502",
          "description": "Modbus TCP communication port"
        }
      ],
      "integrity_hash": "sha256:878b9b54ced171c23e7a4651ea68fb2e1da796178bce58c21f81d2c80cdc1341",
      "dependency_manifest": "requirements.txt",
      "dependency_provenance": [
        {
          "package": "mcp",
          "version": "1.29.1",
          "artifact": "mcp-1.29.1-py3-none-any.whl",
          "sha256": "b6310eeb59153300c4ab8b9aec4c52f4819a2d6a8e429eb43d908bed7c783648",
          "source": "https://pypi.org/project/mcp/1.29.1/"
        },
        {
          "package": "pyserial",
          "version": "3.5",
          "artifact": "pyserial-3.5-py2.py3-none-any.whl",
          "sha256": "c4451db6ba391ca6ca299fb3ec7bae67a5c55dde170964c7a14ceefec02f2cf0",
          "source": "https://pypi.org/project/pyserial/3.5/"
        },
        {
          "package": "pymodbus",
          "version": "3.15.0",
          "artifact": "pymodbus-3.15.0-py3-none-any.whl",
          "sha256": "74d8dee961f23845f18a8481253183504dca05c4fcd102890cd28f4d7ce09267",
          "source": "https://pypi.org/project/pymodbus/3.15.0/"
        }
      ],
      "tools": [
        {
          "id": "hardware-edge-sensors:read_scale_weight",
          "name": "read_scale_weight",
          "description": "Connect to a serial weighing scale and read the current weight",
          "risk": "read",
          "recommendedGoalIds": [
            "inventory",
            "order-fulfillment"
          ],
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "id": "hardware-edge-sensors:read_temperature_sensor",
          "name": "read_temperature_sensor",
          "description": "Read current temperature from a Modbus TCP industrial thermal sensor",
          "risk": "read",
          "recommendedGoalIds": [
            "compliance-review",
            "inventory"
          ],
          "inputSchema": {
            "type": "object",
            "properties": {
              "register_address": { "type": "integer", "default": 100, "description": "Modbus holding register address" }
            }
          }
        },
        {
          "id": "hardware-edge-sensors:read_pressure_sensor",
          "name": "read_pressure_sensor",
          "description": "Read current pressure from a Modbus TCP industrial pressure sensor",
          "risk": "read",
          "recommendedGoalIds": [
            "compliance-review",
            "inventory"
          ],
          "inputSchema": {
            "type": "object",
            "properties": {
              "register_address": { "type": "integer", "default": 200, "description": "Modbus holding register address" }
            }
          }
        }
      ],
      "config": {
        "mcpServers": {
          "hardware-edge-sensors": {
            "command": "python",
            "args": [
              "server.py"
            ],
            "env": {
              "SCALE_COM_PORT": "${SCALE_COM_PORT}",
              "SCALE_BAUDRATE": "${SCALE_BAUDRATE}",
              "MODBUS_SENSOR_IP": "${MODBUS_SENSOR_IP}",
              "MODBUS_PORT": "${MODBUS_PORT}"
            }
          }
        }
      }
    },
    {
