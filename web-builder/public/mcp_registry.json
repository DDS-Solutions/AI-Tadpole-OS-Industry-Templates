  "connectors": [
    {
      "id": "mcp-generic-crm",
      "name": "Generic REST & Webhook CRM Blueprint",
      "description": "Sample reference MCP server returning simulated mock responses for querying REST endpoints and receiving webhooks from SMB SaaS platforms like HubSpot, Salesforce, etc.",
      "category": "CRM & SaaS",
      "path": "mcp-blueprints/generic-crm",
      "version": "1.0.0",
      "author": "AI-Tadpole-OS Core",
      "status": "sample",
      "maintainer": "AI-Tadpole-OS Security Team",
      "last_reviewed": "2026-11-13",
      "required_env": {
        "CRM_API_KEY": {
          "description": "API token for CRM access",
          "placeholder": "CONFIGURE_LOCALLY"
        }
      },
      "variables": [
        {
          "name": "CRM_API_KEY",
          "type": "secret",
          "required": true,
          "description": "API token for CRM access"
        }
      ],
      "integrity_hash": "sha256:141da6c37f0a1dbcab3b05c78678feaeff000a6031b0733b7f3a9448bd83f6d6",
      "dependency_manifest": "requirements.txt",
      "dependency_provenance": [
        {
          "package": "mcp",
          "version": "1.29.1",
          "artifact": "mcp-1.29.1-py3-none-any.whl",
          "sha256": "b6310eeb59153300c4ab8b9aec4c52f4819a2d6a8e429eb43d908bed7c783648",
          "source": "https://pypi.org/project/mcp/1.29.1/"
        }
      ],
      "tools": [
        {
          "id": "generic-crm:get_crm_contact",
          "name": "get_crm_contact",
          "description": "Get a CRM contact by ID",
          "risk": "read",
          "recommendedGoalIds": [
            "customer-follow-up",
            "quoting"
          ],
          "inputSchema": {
            "type": "object",
            "required": ["contact_id"],
            "properties": {
              "contact_id": { "type": "string", "description": "Unique CRM contact identifier" }
            }
          }
        },
        {
          "id": "generic-crm:update_invoice",
          "name": "update_invoice",
          "description": "Update invoice status",
          "risk": "write",
          "recommendedGoalIds": [
            "quoting",
            "bookkeeping"
          ],
          "inputSchema": {
            "type": "object",
            "required": ["invoice_id", "status"],
            "properties": {
              "invoice_id": { "type": "string", "description": "Invoice identifier" },
              "status": { "type": "string", "description": "Target invoice lifecycle status" }
            }
          }
        },
        {
          "id": "generic-crm:list_recent_changes",
          "name": "list_recent_changes",
          "description": "List recent changes in CRM",
          "risk": "read",
          "recommendedGoalIds": [
            "customer-follow-up",
            "scheduling"
          ],
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        }
      ],
      "config": {
        "mcpServers": {
          "generic-crm": {
            "command": "python",
            "args": [
              "server.py"
            ],
            "env": {
              "CRM_API_KEY": "CONFIGURE_LOCALLY"
            }
          }
        }
      }
    },
    {
