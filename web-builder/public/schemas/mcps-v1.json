{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tadpoleos.dev/schemas/mcps-v1.json",
  "title": "AI-Tadpole-OS Template MCP Configuration Schema",
  "type": "object",
  "required": ["mcpServers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*__)(?![Gg][Ee][Vv]$).+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": { "type": "string", "enum": ["node", "npx", "python", "python3"] },
          "args": {
            "type": "array",
            "items": { "type": "string" }
          },
          "env": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "url": { "type": "string", "minLength": 1 },
          "headers": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "protocol_version": { "type": "string", "enum": ["2026-07-28", "2024-11-05"] },
          "protocol_versions": {
            "type": "array",
            "items": { "type": "string", "enum": ["2026-07-28", "2024-11-05"] }
          },
          "cwd": { "type": "string" },
          "transport": { "type": "string" }
        },
        "anyOf": [
          { "required": ["command"] },
          { "required": ["url"] }
        ]
      }
    }
  }
}

