{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "title": "AI-Tadpole-OS Swarm Manifest Schema",
  "type": "object",
  "required": ["name", "description", "industry", "roster"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "company_size": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        }
      }
    },
    "model": {
      "type": "string"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roster": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "supervisor": {
            "type": ["string", "null"]
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "normal", "low"]
          }
        }
      }
    },
    "connector_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_mcps": {
      "type": "string"
    },
    "global_workflows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
