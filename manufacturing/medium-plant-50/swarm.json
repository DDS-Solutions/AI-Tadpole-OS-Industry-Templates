{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "id": "manufacturing-medium-plant-50",
  "name": "Medium Plant (50 Seats)",
  "industry": "Manufacturing",
  "company_size": 50,
  "description": "Predictive maintenance and supply chain orchestration for medium-sized facilities.",
  "author": "AI-Tadpole-OS",
  "tags": [
    "manufacturing",
    "maintenance",
    "supply-chain",
    "analytics"
  ],
  "path": "manufacturing/medium-plant-50",
  "agents": [
    "specialized-supply-chain-strategist",
    "engineering-engineering-it-service-manager",
    "support-support-infrastructure-maintainer"
  ],
  "global_workflows": [
    "workflows/maintenance_cycle.md"
  ],
  "version": "1.0.0",
  "roster": [
    {
      "id": "specialized-supply-chain-strategist",
      "path": "agents/specialized-supply-chain-strategist.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "engineering-engineering-it-service-manager",
      "path": "agents/engineering-engineering-it-service-manager.json",
      "supervisor": "specialized-supply-chain-strategist",
      "priority": "normal"
    },
    {
      "id": "support-support-infrastructure-maintainer",
      "path": "agents/support-support-infrastructure-maintainer.json",
      "supervisor": "specialized-supply-chain-strategist",
      "priority": "normal"
    }
  ],
  "maturity": "starter",
  "defaults": {
    "model": "gemma4:31b-cloud",
    "provider": "ollama-cloud",
    "temperature": 0.4
  }
}
