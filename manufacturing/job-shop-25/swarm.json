{
  "$schema": "https://tadpoleos.dev/schemas/swarm-v1.json",
  "id": "manufacturing-job-shop-25",
  "name": "Job Shop 25-Seat Operations Swarm",
  "industry": "Manufacturing",
  "company_size": 25,
  "description": "Shopfloor Operations: Work order scheduling, receiving traveler verification, job costing, and QA inspection.",
  "author": "AI-Tadpole-OS",
  "tags": [
    "manufacturing",
    "production",
    "inventory",
    "quality"
  ],
  "path": "manufacturing/job-shop-25",
  "agents": [
    "operations-production-scheduler",
    "operations-receiving-traveler-clerk",
    "finance-job-costing-estimator",
    "testing-quality-inspector-traveler"
  ],
  "version": "1.0.0",
  "roster": [
    {
      "id": "operations-production-scheduler",
      "path": "agents/operations-production-scheduler.json",
      "supervisor": null,
      "priority": "critical"
    },
    {
      "id": "operations-receiving-traveler-clerk",
      "path": "agents/operations-receiving-traveler-clerk.json",
      "supervisor": "operations-production-scheduler",
      "priority": "normal"
    },
    {
      "id": "finance-job-costing-estimator",
      "path": "agents/finance-job-costing-estimator.json",
      "supervisor": "operations-production-scheduler",
      "priority": "normal"
    },
    {
      "id": "testing-quality-inspector-traveler",
      "path": "agents/testing-quality-inspector-traveler.json",
      "supervisor": "operations-production-scheduler",
      "priority": "normal"
    }
  ],
  "defaults": {
    "model": "gemma4:31b-cloud",
    "temperature": 0.2,
    "provider": "ollama-cloud"
  },
  "maturity": "starter"
}
